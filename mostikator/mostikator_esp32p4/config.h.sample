#pragma once

/* ================= WIFI ================= */
#define WIFI_SSID     "CHANGE_ME"
#define WIFI_PASS     "CHANGE_ME"

/* Fallback WiFi: used if primary SSID is not found */
#define WIFI_SSID2    "iphone_wifi"
#define WIFI_PASS2    "CHANGE_ME"

#define DEVICE_NAME   "mostikator-p4-01"

/* ================= SIGNALK (MQTT bridge, same as the pond sensor) ================= */
#define MQTT_HOST     "192.168.1.16"
#define MQTT_PORT     1883
#define MQTT_TOPIC    "signalk/delta"

/* ================= HTTP / WEBSOCKET ================= */
/* REST API + MJPEG + static webapp (LittleFS) */
#define HTTP_PORT     80
/* JSON event stream (targets, stats, status) */
#define WS_PORT       82

/* ================= CAMERA (MIPI-CSI, OV5647) ================= */
/* Waveshare ESP32-P4-WIFI6: SCCB on I2C0, SCL GPIO8, SDA GPIO7 */
#define CAM_SCCB_I2C_PORT  0
#define CAM_SCCB_SCL       8
#define CAM_SCCB_SDA       7
#define CAM_RESET_PIN     -1
#define CAM_PWDN_PIN      -1

/* Sensor defaults (-1 = keep driver default) */
#define CAM_GAIN          -1
#define CAM_EXPOSURE      -1
#define CAM_VFLIP          0
#define CAM_HFLIP          0

/* Field of view used to convert pixel coordinates to pan/tilt angles.
 * Pi Camera v3 (75° diag): 66° x 41°. OV5647 Waveshare module (72° diag): ~62° x 49°. */
#define CAM_HFOV_DEG      66.0f
#define CAM_VFOV_DEG      41.0f

/* Hardware JPEG encoder quality (1-100) for /api/capture and /api/stream */
#define JPEG_QUALITY      75

/* ================= DETECTOR DEFAULTS (adjustable live via POST /api/config) ================= */
#define DET_DOWNSCALE        4    /* working grid = frame / N (4 -> 480x270 for 1080p) */
#define DET_THRESHOLD       28    /* luma difference vs background (0-255) */
#define DET_MIN_AREA         2    /* blob area in working pixels */
#define DET_MAX_AREA       120
#define DET_CONFIRM_FRAMES   3    /* consecutive frames before a track becomes a target */
#define DET_MISS_FRAMES      8    /* frames without match before a track is dropped */
#define DET_MAX_MATCH_DIST  24    /* working pixels */
#define DET_LEARN_SHIFT      5    /* background learning rate = 1/2^n per frame */
#define DET_DARK_ONLY        1    /* mosquitoes are darker than a bright background */
#define DET_WARMUP_FRAMES   30
#define DET_LEAD_MS        150    /* prediction lead sent to the turret */
#define DET_ROI_X0        0.02f
#define DET_ROI_Y0        0.02f
#define DET_ROI_X1        0.98f
#define DET_ROI_Y1        0.98f

/* Arm the detector automatically at boot */
#define DET_AUTO_ARM         1

/* ================= PUBLISHING ================= */
#define PUBLISH_STATUS_MS  5000   /* status + stats to SignalK / WS */
#define PUBLISH_TARGET_MS   200   /* target position rate limit (5 Hz) */

/* ================= OPTIONAL 16x2 LCD (HD44780, 4-bit) ================= */
#define LCD_ENABLED  0
#define LCD_RS      20
#define LCD_EN      21
#define LCD_D4      22
#define LCD_D5      23
#define LCD_D6      26
#define LCD_D7      27

/* ================= STATUS LED (-1 = none) ================= */
#define LED_PIN     -1

/* ================= WATCHDOG ================= */
#define WDT_TIMEOUT_S 30
