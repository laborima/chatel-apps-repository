#pragma once

/* ================= WIFI / REMOTE MAINTENANCE ================= */
/* WiFi only serves maintenance: OTA firmware updates and the telnet console. The turret keeps
 * working without it (PS5 over Bluetooth, link to the P4 over UART). Leave WIFI_SSID empty to disable. */
#define WIFI_SSID     "your-ssid"
#define WIFI_PASS     "your-password"
#define WIFI_SSID2    "your-ssid2"        /* tried when the first one is not found, "" = none */
#define WIFI_PASS2    "your-password"
#define WIFI_RETRY_MS 15000

#define DEVICE_NAME   "mostikator-turret" /* mDNS: mostikator-turret.local */

/* Password for OTA uploads (espota, port 3232) and for the telnet console (port 23).
 * The telnet console can arm and fire the water gun: never leave it empty. */
#define OTA_PASSWORD  "change-me"
#define OTA_PORT      3232
#define TELNET_PORT   23

/* ================= PS5 DUALSENSE (Bluetooth Classic, lib esp-ps5) ================= */
/* Leave empty to scan + pair (hold PS + Create on the controller until the lightbar pulses white).
 * Or set the controller MAC "AA:BB:CC:DD:EE:FF" to connect without scanning. */
#define PS5_MAC             ""
#define PS5_PAIR_TIMEOUT_S  20

/* ================= SERVOS (Futaba S3003) ================= */
/* Avoid strapping pins (0, 2, 12, 15) and input-only pins (34-39) on the ELEGOO ESP32.
 * -1 = no servo on that axis (the angle is still tracked, nothing is driven). */
#define PIN_SERVO_PAN   -1
#define PIN_SERVO_TILT  13

/* Hard pulse limits: the firmware never drives a servo outside this range whatever the calibration.
 * Futaba S3003: neutral 1520 us, ~800-2200 us for the full travel. */
#define SERVO_US_MIN   700
#define SERVO_US_MAX  2300

/* Default calibration (overwritten by the calibration saved in NVS, see README "Réglage des servos").
 * Each axis is defined by two points: pulse width (us) + real-world angle (deg) at that pulse.
 *   tilt "low"  = barrel at the mechanical bottom stop
 *   tilt "high" = barrel at the top stop
 *   pan  "low"  = turret fully left, "high" = fully right
 * Angles are relative to the camera axis (0 = straight ahead / horizontal), like the detector's pan/tilt.
 * Swapping usLow/usHigh reverses the direction of an axis.
 * Tilt values = calibration measured on the turret and saved in NVS on 2026-09-24. */
#define PAN_US_LOW    1000
#define PAN_DEG_LOW    -60.0f
#define PAN_US_HIGH   2000
#define PAN_DEG_HIGH    60.0f
#define TILT_US_LOW   1540
#define TILT_DEG_LOW   -20.0f
#define TILT_US_HIGH  1810
#define TILT_DEG_HIGH   60.0f

/* Position at boot / "center" (Triangle) */
#define TURRET_HOME_PAN    0.0f
#define TURRET_HOME_TILT   0.0f

/* Slew limit (deg/s) – protects the gears and the Lego */
#define TURRET_MAX_SPEED_DEGS  150.0f

/* Calibration step (us) for the D-pad / console "+" and "-" */
#define CAL_STEP_US  10

/* ================= CONTROLLER FEEL ================= */
#define STICK_DEADZONE        12       /* raw units out of 127 */
#define STICK_MAX_SPEED_DEGS  90.0f    /* left stick fully pushed */
#define STICK_FINE_SPEED_DEGS 20.0f    /* right stick: fine aiming */
#define STICK_EXPO            0.5f     /* 0 = linear, 1 = cubic (soft around the center) */
#define TILT_STICK_INVERT     0        /* 1 if pushing the stick up should lower the barrel */
#define NUDGE_DEG             1.0f     /* D-pad */
#define FIRE_TRIGGER_THRESHOLD 60      /* R2 0..255 */

/* ================= 4-RELAY BOARD (SRD-05VDC-SL-C, inputs active LOW) ================= */
/* Mapping checked on the turret with the controller on 2026-09-24 */
#define PIN_RELAY_PUMP   26     /* 12 V pump */
#define PIN_RELAY_VALVE  27     /* solenoid valve (relay 2) */
#define PIN_RELAY_LASER  25     /* aiming laser (relay 3), -1 = none */
#define PIN_RELAY_LEDS   14     /* green LED lighting on the jet, -1 = none */
#define RELAY_ACTIVE_LOW  1

/* Piezo / speaker (laser sound). -1 = none */
#define PIN_BUZZER       32

#define FIRE_TAP_MS       150   /* burst length for a short press */
#define FIRE_MAX_MS      1500   /* longest continuous burst, even with the button held */
#define FIRE_MIN_GAP_MS   150   /* valve rest between bursts */
#define PUMP_IDLE_OFF_MS 90000  /* pump auto-off after this idle time (0 = never) */
#define LED_AFTERGLOW_MS  250   /* LEDs stay on this long after the valve closes (when not toggled on) */
#define LASER_MAX_ON_MS 600000  /* laser auto-off after 10 min on (0 = never) */

/* ================= LINK TO THE DETECTION NODE (ESP32-P4, UART2) ================= */
/* 3 wires, both boards in 3.3 V logic:
 *   GPIO17 (TX2) -> P4 GPIO21 (RX)    GPIO16 (RX2) <- P4 GPIO20 (TX)    GND <-> GND
 * Every manual shot is announced on this link so the P4 plays the blaster on the speaker
 * plugged into its own board: the turret has no speaker of its own beyond the piezo.
 * The P4 can also send AIM / FIRE, refused while the PS5 controller is connected. */
#define LINK_ENABLED     1
#define LINK_UART_NUM    2
#define LINK_TX_PIN     17
#define LINK_RX_PIN     16
#define LINK_BAUD   115200
#define LINK_HEARTBEAT_MS 5000  /* "HB" line so the P4 knows the turret is alive (its timeout is 15 s) */

/* ================= WATCHDOG ================= */
#define WDT_TIMEOUT_S 30
