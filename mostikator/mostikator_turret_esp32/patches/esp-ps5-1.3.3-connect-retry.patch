+// MARK: l2cap_drop_pending - abandon an outbound connect that never completed.
+// Bluedroid does not always report a page timeout through connect_cfm, and a stale CID blocks every
+// later retry in isConnected(). Only touches a link that is not configured.
+void ps5_l2cap_drop_pending(void) {
+    if (is_connected) return;
+    if (l2cap_control_channel && !l2cap_ctrl_configured) {
+        L2CA_DisconnectReq(l2cap_control_channel);
+        l2cap_control_channel = 0;
+    }
+    if (l2cap_interrupt_channel && !l2cap_int_configured) {
+        L2CA_DisconnectReq(l2cap_interrupt_channel);
+        l2cap_interrupt_channel = 0;
+    }
+}
+
