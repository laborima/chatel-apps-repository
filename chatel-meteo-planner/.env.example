# SignalK Server Configuration
# Leave empty to use the current page origin (default when deployed as SignalK webapp)
# Set to a specific URL for development or when running standalone
NEXT_PUBLIC_SIGNALK_URL=

# Examples:
# NEXT_PUBLIC_SIGNALK_URL=http://localhost:3000
# NEXT_PUBLIC_SIGNALK_URL=http://192.168.x.x:3000
# NEXT_PUBLIC_SIGNALK_URL=http://signalk.local:3000
